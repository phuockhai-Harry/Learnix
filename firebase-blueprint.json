{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing role and identity information.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"]
        },
        "realName": {
          "type": "string",
          "maxLength": 100
        },
        "codeName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["role", "realName", "createdAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A quiz created by a student or teacher.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "creatorId": {
          "type": "string",
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["title", "creatorId", "isPublic", "createdAt"]
    },
    "Submission": {
      "title": "Quiz Submission",
      "description": "A student's completion record of a quiz.",
      "type": "object",
      "properties": {
        "quizId": {
          "type": "string",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "score": {
          "type": "number"
        },
        "completedAt": {
          "type": "timestamp"
        }
      },
      "required": ["quizId", "studentId", "score", "completedAt"]
    },
    "StudyPlan": {
      "title": "Study Plan",
      "description": "A student's exam dates and generated daily study schedule.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "exams": {
          "type": "array"
        },
        "schedule": {
          "type": "array"
        },
        "dailyHoursTarget": {
          "type": "number"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["studentId", "exams", "schedule"]
    },
    "LessonProgress": {
      "title": "Lesson Progress",
      "description": "Records student completion, scores, and mastery of individual lessons and modules.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "lessonId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "maxLength": 100
        },
        "grade": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed"]
        },
        "completed": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "mastery": {
          "type": "number"
        },
        "lastAccessedAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["studentId", "lessonId", "status", "completed"]
    },
    "LearningPath": {
      "title": "Personalized Learning Path",
      "description": "Stores personalized learning path data including milestones, target goals, pace, and recommendations.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "grade": {
          "type": "number"
        },
        "targetGoal": {
          "type": "string",
          "maxLength": 200
        },
        "overallProgress": {
          "type": "number"
        },
        "dailyPaceMinutes": {
          "type": "number"
        },
        "strengths": {
          "type": "array"
        },
        "focusAreas": {
          "type": "array"
        },
        "milestones": {
          "type": "array"
        },
        "recommendedModules": {
          "type": "array"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["studentId", "grade", "targetGoal", "overallProgress", "milestones"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/quizzes/{quizId}": {
      "schema": {
        "$ref": "#/entities/Quiz"
      },
      "description": "Stores quiz metadata."
    },
    "/submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/Submission"
      },
      "description": "Stores quiz submissions."
    },
    "/studyPlans/{planId}": {
      "schema": {
        "$ref": "#/entities/StudyPlan"
      },
      "description": "Stores student study schedules and exam dates."
    },
    "/progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/LessonProgress"
      },
      "description": "Stores individual student lesson and module completion progress."
    },
    "/learningPaths/{pathId}": {
      "schema": {
        "$ref": "#/entities/LearningPath"
      },
      "description": "Stores student personalized learning path and milestone roadmap."
    }
  }
}
