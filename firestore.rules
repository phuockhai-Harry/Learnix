rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTeacher() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data.role == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'phuockhaihhqt@gmail.com' || (resource != null && resource.data.role == 'admin'));
    }

    // --- Users ---
    function isValidUser(data) {
      return data.keys().hasAll(['role', 'realName', 'createdAt'])
        && data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'admin')
        && data.realName is string && data.realName.size() <= 100
        && (!data.keys().hasAny(['email']) || (data.email is string))
        && (!data.keys().hasAny(['studentEmails']) || (data.studentEmails is list))
        && (!data.keys().hasAny(['classes']) || (data.classes is list))
        && (!data.keys().hasAny(['codeName']) || (data.codeName is string && data.codeName.size() <= 100))
        && (!data.keys().hasAny(['streakCount']) || (data.streakCount is number))
        && (!data.keys().hasAny(['lastActiveDate']) || (data.lastActiveDate is string))
        && (!data.keys().hasAny(['earnedBadges']) || (data.earnedBadges is list))
        && (!data.keys().hasAny(['xp']) || (data.xp is number))
        && (!data.keys().hasAny(['grade']) || (data.grade is number))
        && (!data.keys().hasAny(['missedHomeworks']) || (data.missedHomeworks is list))
        && data.createdAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'admin')
        && data.realName is string && data.realName.size() <= 100
        && (!data.keys().hasAny(['email']) || (data.email is string))
        && (!data.keys().hasAny(['studentEmails']) || (data.studentEmails is list))
        && (!data.keys().hasAny(['classes']) || (data.classes is list))
        && (!data.keys().hasAny(['codeName']) || (data.codeName is string && data.codeName.size() <= 100))
        && (!data.keys().hasAny(['streakCount']) || (data.streakCount is number))
        && (!data.keys().hasAny(['lastActiveDate']) || (data.lastActiveDate is string))
        && (!data.keys().hasAny(['earnedBadges']) || (data.earnedBadges is list))
        && (!data.keys().hasAny(['xp']) || (data.xp is number))
        && (!data.keys().hasAny(['grade']) || (data.grade is number))
        && (!data.keys().hasAny(['missedHomeworks']) || (data.missedHomeworks is list));
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().keys().size() <= 12;

      allow update: if isSignedIn() 
        && (request.auth.uid == userId || request.auth.token.email == 'phuockhaihhqt@gmail.com')
        && isValidUserUpdate(incoming())
        && (incoming().role == existing().role || request.auth.token.email == 'phuockhaihhqt@gmail.com')
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'realName', 'codeName', 'updatedAt', 'streakCount', 'lastActiveDate', 'earnedBadges', 'xp', 'studentEmails', 'email', 'classes', 'grade', 'missedHomeworks']);

      allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'phuockhaihhqt@gmail.com');
    }

    // --- Quizzes ---
    function isValidQuiz(data) {
      return data.keys().hasAll(['title', 'creatorId', 'isPublic', 'questionsData', 'createdAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.creatorId is string && data.creatorId.size() <= 128
        && data.isPublic is bool
        && data.questionsData is string && data.questionsData.size() <= 1048576
        && data.createdAt == request.time;
    }

    function isValidQuizUpdate(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.creatorId is string && data.creatorId.size() <= 128
        && data.isPublic is bool
        && data.questionsData is string && data.questionsData.size() <= 1048576;
    }

    match /quizzes/{quizId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(quizId)
        && isValidQuiz(incoming())
        && incoming().creatorId == request.auth.uid;
        
      allow update: if isSignedIn()
        && (existing().creatorId == request.auth.uid || isTeacher())
        && isValidQuizUpdate(incoming());
        
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || isTeacher());
    }

    // --- Classes ---
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if (isTeacher() && resource.data.teacherId == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentEmails']));
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // --- Submissions (Quiz Scores) ---
    function isValidSubmission(data) {
      return data.keys().hasAll(['quizId', 'studentId', 'score', 'completedAt'])
        && data.quizId is string && data.quizId.size() <= 128
        && data.studentId is string && data.studentId.size() <= 128
        && (!data.keys().hasAny(['teacherId']) || (data.teacherId is string && data.teacherId.size() <= 128))
        && (!data.keys().hasAny(['quizTitle']) || (data.quizTitle is string && data.quizTitle.size() <= 200))
        && (!data.keys().hasAny(['syncedFromOffline']) || (data.syncedFromOffline is bool))
        && (!data.keys().hasAny(['offlineCompletedAt']) || (data.offlineCompletedAt is string && data.offlineCompletedAt.size() <= 64))
        && (!data.keys().hasAny(['teacherComment']) || (data.teacherComment is string && data.teacherComment.size() <= 1000))
        && data.score is number
        && data.completedAt == request.time;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid || isTeacher() || isAdmin());
      allow list: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(submissionId)
        && isValidSubmission(incoming())
        && incoming().studentId == request.auth.uid;
        
      allow update: if isSignedIn() && isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherComment']);
      allow delete: if isSignedIn() && ((isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin());
    }

    // --- Lesson Progress (Cloud storage for lesson completion & mastery) ---
    function isValidProgress(data) {
      return data.keys().hasAll(['studentId', 'lessonId', 'status', 'completed'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.lessonId is string && data.lessonId.size() <= 128
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 200))
        && (!data.keys().hasAny(['subject']) || (data.subject is string && data.subject.size() <= 100))
        && (!data.keys().hasAny(['grade']) || (data.grade is number))
        && data.status is string && (data.status == 'not_started' || data.status == 'in_progress' || data.status == 'completed')
        && data.completed is bool
        && (!data.keys().hasAny(['score']) || (data.score is number))
        && (!data.keys().hasAny(['mastery']) || (data.mastery is number && data.mastery >= 0 && data.mastery <= 100))
        && (!data.keys().hasAny(['lastAccessedAt']) || (data.lastAccessedAt is timestamp))
        && (!data.keys().hasAny(['completedAt']) || (data.completedAt is timestamp))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp));
    }

    function isValidProgressUpdate(data) {
      return data.studentId is string && data.studentId.size() <= 128
        && data.lessonId is string && data.lessonId.size() <= 128
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 200))
        && (!data.keys().hasAny(['subject']) || (data.subject is string && data.subject.size() <= 100))
        && (!data.keys().hasAny(['grade']) || (data.grade is number))
        && data.status is string && (data.status == 'not_started' || data.status == 'in_progress' || data.status == 'completed')
        && data.completed is bool
        && (!data.keys().hasAny(['score']) || (data.score is number))
        && (!data.keys().hasAny(['mastery']) || (data.mastery is number && data.mastery >= 0 && data.mastery <= 100))
        && (!data.keys().hasAny(['lastAccessedAt']) || (data.lastAccessedAt is timestamp))
        && (!data.keys().hasAny(['completedAt']) || (data.completedAt is timestamp))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp));
    }

    match /progress/{progressId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isAdmin());
      allow list: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(progressId)
        && isValidProgress(incoming())
        && incoming().studentId == request.auth.uid;
        
      allow update: if isSignedIn() 
        && (existing().studentId == request.auth.uid || isAdmin())
        && isValidProgressUpdate(incoming())
        && incoming().studentId == existing().studentId
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completed', 'score', 'mastery', 'lastAccessedAt', 'completedAt', 'updatedAt', 'title', 'subject', 'grade']);
        
      allow delete: if isSignedIn() && (existing().studentId == request.auth.uid || isAdmin());
    }

    // --- Personalized Learning Paths ---
    function isValidLearningPath(data) {
      return data.keys().hasAll(['studentId', 'grade', 'targetGoal', 'overallProgress', 'milestones'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.grade is number
        && data.targetGoal is string && data.targetGoal.size() <= 200
        && data.overallProgress is number && data.overallProgress >= 0 && data.overallProgress <= 100
        && (!data.keys().hasAny(['dailyPaceMinutes']) || (data.dailyPaceMinutes is number))
        && (!data.keys().hasAny(['strengths']) || (data.strengths is list && data.strengths.size() <= 20))
        && (!data.keys().hasAny(['focusAreas']) || (data.focusAreas is list && data.focusAreas.size() <= 20))
        && data.milestones is list && data.milestones.size() <= 50
        && (!data.keys().hasAny(['recommendedModules']) || (data.recommendedModules is list && data.recommendedModules.size() <= 20))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp));
    }

    function isValidLearningPathUpdate(data) {
      return data.studentId is string && data.studentId.size() <= 128
        && data.grade is number
        && data.targetGoal is string && data.targetGoal.size() <= 200
        && data.overallProgress is number && data.overallProgress >= 0 && data.overallProgress <= 100
        && (!data.keys().hasAny(['dailyPaceMinutes']) || (data.dailyPaceMinutes is number))
        && (!data.keys().hasAny(['strengths']) || (data.strengths is list && data.strengths.size() <= 20))
        && (!data.keys().hasAny(['focusAreas']) || (data.focusAreas is list && data.focusAreas.size() <= 20))
        && data.milestones is list && data.milestones.size() <= 50
        && (!data.keys().hasAny(['recommendedModules']) || (data.recommendedModules is list && data.recommendedModules.size() <= 20))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp));
    }

    match /learningPaths/{pathId} {
      allow get: if isSignedIn() && (request.auth.uid == pathId || resource.data.studentId == request.auth.uid || isTeacher() || isAdmin());
      allow list: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(pathId)
        && (request.auth.uid == pathId || incoming().studentId == request.auth.uid)
        && isValidLearningPath(incoming());
        
      allow update: if isSignedIn() 
        && (request.auth.uid == pathId || existing().studentId == request.auth.uid || isAdmin())
        && isValidLearningPathUpdate(incoming())
        && incoming().studentId == existing().studentId
        && incoming().diff(existing()).affectedKeys().hasOnly(['grade', 'targetGoal', 'overallProgress', 'dailyPaceMinutes', 'strengths', 'focusAreas', 'milestones', 'recommendedModules', 'updatedAt']);
        
      allow delete: if isSignedIn() && (request.auth.uid == pathId || existing().studentId == request.auth.uid || isAdmin());
    }

    // --- Study Plans ---
    match /studyPlans/{planId} {
      allow get: if isSignedIn() && (request.auth.uid == planId || isTeacher() || (resource != null && resource.data.studentId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == planId || request.resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == planId || (resource != null && resource.data.studentId == request.auth.uid) || isAdmin());
    }
  }
}
